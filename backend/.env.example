DATABASE_URL=postgresql+psycopg2://rtm_user:rtm_password@localhost:5433/rtm_db
CORS_ORIGINS=http://localhost:5173

# GitHub Code & Branch Coverage feature — never commit real values.
# GITHUB_TOKEN needs `repo` scope (read access) to check collaborator status
# and clone private repos; a fine-grained PAT with read-only contents+metadata
# works too as long as it can call /user, /repos/{owner}/{repo}, and
# /repos/{owner}/{repo}/collaborators/{username}.
GITHUB_USERNAME=
GITHUB_TOKEN=
# Optional: cap how long a clone+install+test run may take before it's killed.
COVERAGE_JOB_TIMEOUT_SECONDS=300
